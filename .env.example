# ==============================================================================
# NAVOSYS Website MVP - Environment Variables Example
# Copy to local .env / apps/web/.env.local / cms/.env as needed. Never commit real secrets.
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-Side Strapi CMS Connection (used by Next.js in P04+) ---
# Keep API tokens server-only; never prefix privileged tokens with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=replace-with-server-only-strapi-api-token
STRAPI_PREVIEW_SECRET=replace-with-random-preview-secret
STRAPI_REVALIDATE_SECRET=replace-with-random-revalidation-secret

# --- Strapi 5 Server & Secrets (cms/.env) ---
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
API_TOKEN_SALT=replace-with-random-salt
ADMIN_JWT_SECRET=replace-with-random-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-random-transfer-salt
JWT_SECRET=replace-with-random-jwt-secret
ENCRYPTION_KEY=replace-with-random-encryption-key

# --- PostgreSQL Configuration (Local Docker Compose binds 127.0.0.1:5434) ---
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
POSTGRES_HOST_PORT=5434
DATABASE_NAME=navosys_cms
DATABASE_USERNAME=navosys_user
DATABASE_PASSWORD=replace-with-strong-db-password
DATABASE_SSL=false

# --- Lead Notification / Email (used in P17+) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFICATION_TO=
