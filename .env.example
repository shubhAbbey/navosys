# ==============================================================================
# NAVOSYS Website MVP - Environment Variables Example
# Copy to local .env / apps/web/.env.local as needed. Never commit real secrets.
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-Side Strapi CMS Connection (populated in P02+) ---
# Keep API tokens server-only; never prefix privileged tokens with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=replace-with-server-only-strapi-api-token
STRAPI_PREVIEW_SECRET=replace-with-random-preview-secret
STRAPI_REVALIDATE_SECRET=replace-with-random-revalidation-secret

# --- Strapi & PostgreSQL Configuration (used by Strapi in P02+) ---
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
STRAPI_APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
STRAPI_API_TOKEN_SALT=replace-with-random-salt
STRAPI_ADMIN_JWT_SECRET=replace-with-random-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=replace-with-random-transfer-salt
STRAPI_JWT_SECRET=replace-with-random-jwt-secret

DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=navosys_cms
DATABASE_USERNAME=navosys_user
DATABASE_PASSWORD=replace-with-strong-db-password
DATABASE_SSL=false

# --- Lead Notification / Email (used in P17+) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFICATION_TO=
