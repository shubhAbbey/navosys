{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry",
    "description": "CMS-driven industry capability & domain use-case pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "fullPath": {
      "type": "string",
      "unique": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "overview": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredImageAlt": {
      "type": "string"
    },
    "keyChallenges": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "solutionPatterns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "useCases": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "complianceConsiderations": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "relatedCaseStudies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "relatedIndustries"
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "isIndexable": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.card-grid",
        "sections.cta-banner",
        "sections.process-steps",
        "sections.faq-accordion",
        "sections.comparison-table",
        "sections.tabs",
        "sections.image-text"
      ]
    }
  }
}
