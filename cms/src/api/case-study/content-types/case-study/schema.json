{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "CMS-driven portfolio studies and conceptual reference architectures"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "fullPath": {
      "type": "string",
      "unique": true
    },
    "isConceptual": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "categoryLabel": {
      "type": "string",
      "required": true
    },
    "engagementType": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "challenge": {
      "type": "text",
      "required": true
    },
    "solution": {
      "type": "text",
      "required": true
    },
    "approach": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredImageAlt": {
      "type": "string"
    },
    "architectureHighlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "outcomes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "technologies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "relatedIndustries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry.industry",
      "inversedBy": "relatedCaseStudies"
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "isIndexable": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.card-grid",
        "sections.cta-banner",
        "sections.process-steps",
        "sections.faq-accordion",
        "sections.comparison-table",
        "sections.tabs",
        "sections.image-text"
      ]
    }
  }
}
