{
  "kind": "collectionType",
  "collectionName": "navigation_menus",
  "info": {
    "singularName": "navigation-menu",
    "pluralName": "navigation-menus",
    "displayName": "Navigation Menu",
    "description": "Ordered header and footer navigation menus including nested sub-items"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.nav-item"
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.footer-column"
    }
  }
}
