{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "CMS-driven NAVOSYS service offerings grouped by the four pillars"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "fullPath": {
      "type": "string",
      "unique": true
    },
    "pillar": {
      "type": "enumeration",
      "enum": [
        "cloud-and-it",
        "ai-and-automation",
        "software-engineering",
        "data-and-analytics"
      ],
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredImageAlt": {
      "type": "string"
    },
    "capabilities": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "deliverables": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "processSteps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.step-item"
    },
    "technologies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "useCases": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "isIndexable": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.card-grid",
        "sections.cta-banner",
        "sections.process-steps",
        "sections.faq-accordion",
        "sections.comparison-table",
        "sections.tabs",
        "sections.image-text"
      ]
    }
  }
}
