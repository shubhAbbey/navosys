{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Universal CMS-driven pages resolved by normalized full path"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "fullPath": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "home",
        "standard",
        "landing",
        "services_overview",
        "industries_overview",
        "case_studies_overview",
        "insights_overview",
        "contact",
        "legal"
      ],
      "default": "standard",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "text"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page"
    },
    "showBreadcrumbs": {
      "type": "boolean",
      "default": true
    },
    "isIndexable": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
